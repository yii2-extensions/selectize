{
    "name": "yii2-extensions/selectize",
    "type": "library",
    "description": "Selectize widget for Yii Framework 2",
    "homepage": "https://github.com/yii2-extensions/selectize",
    "keywords": [
        "autocomplete",
        "bootstrap5",
        "selectize",
        "tags",
        "widget",
        "yii2",
        "yii2-extension"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yii2-extensions/selectize/issues",
        "source": "https://github.com/yii2-extensions/selectize",
        "docs": "https://github.com/yii2-extensions/selectize/tree/main/docs"
    },
    "require": {
        "php": ">=8.3",
        "php-forge/foxy": "^0.4",
        "yiisoft/yii2": "~2.0.55 || ^22.0@dev"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.7",
        "php-forge/support": "^0.1",
        "phpunit/phpunit": "^10.5",
        "roave/infection-static-analysis-plugin": "^1.34",
        "symplify/easy-coding-standard": "^13.3",
        "yii2-extensions/phpstan": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\selectize\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\selectize\\tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "foxy": true,
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true,
            "infection/extension-installer": true,
            "php-forge/foxy": true
        },
        "foxy": {
            "manager": "native",
            "native-install-dir": "vendor/npm-asset"
        }
    },
    "scripts": {
        "actionlint": "actionlint",
        "check-dependencies": "composer-require-checker check",
        "codespell": "codespell --config .github/linters/.codespellrc",
        "ecs": "ecs check --fix",
        "ecs-check": "ecs check --ansi",
        "editorconfig-checker": "editorconfig-checker -config .github/linters/.editorconfig-checker.json",
        "gitleaks": "gitleaks git --config .github/linters/.gitleaks.toml --redact",
        "markdownlint": "markdownlint-cli2 --config .github/linters/.markdown-lint.yml '**/*.md'",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=-1 vendor/bin/infection"
        ],
        "mutation-static": "@mutation --static-analysis-tool=phpstan",
        "phpstan": "@static",
        "prettier": "prettier --check --config .prettierrc.json --ignore-path .prettierignore '**/*.md' '**/*.{yml,yaml}'",
        "quality": [
            "@actionlint",
            "@codespell",
            "@editorconfig-checker",
            "@markdownlint",
            "@prettier",
            "@yamllint"
        ],
        "security": [
            "@zizmor",
            "@gitleaks"
        ],
        "static": "phpstan --memory-limit=-1",
        "test": "@tests",
        "tests": "phpunit",
        "yamllint": "yamllint -c .github/linters/.yamllint.yml .github",
        "zizmor": "zizmor --persona=pedantic .github"
    },
    "scripts-descriptions": {
        "actionlint": "Lints GitHub Actions workflows with actionlint.",
        "check-dependencies": "Verifies that used symbols are declared as Composer dependencies.",
        "codespell": "Checks spelling with codespell.",
        "ecs": "Applies coding standard fixes with ECS.",
        "ecs-check": "Checks coding standards with ECS without modifying files.",
        "editorconfig-checker": "Checks files against the EditorConfig rules.",
        "gitleaks": "Scans Git history for secrets with Gitleaks.",
        "markdownlint": "Lints Markdown files with markdownlint-cli2.",
        "mutation": "Runs mutation testing with Infection.",
        "mutation-static": "Runs mutation testing with Infection and PHPStan static analysis.",
        "phpstan": "Alias of the static script.",
        "prettier": "Checks Markdown and YAML formatting with Prettier.",
        "quality": "Runs all repository quality checks.",
        "security": "Runs the workflow security and secret scanning checks.",
        "static": "Runs static analysis with PHPStan.",
        "test": "Alias of the tests script.",
        "tests": "Runs PHPUnit.",
        "yamllint": "Lints YAML files with yamllint.",
        "zizmor": "Audits GitHub Actions workflows with zizmor."
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
